root = true

[*]
charset = utf-8
end_of_line = lf
tab_width = 4
indent_style = tab
insert_final_newline = true

[*.yml]
indent_style = space
indent_size = 2
insert_final_newline = true

[**/src/*/resources/pack.mcmeta]
insert_final_newline = unset

[**/src/*/resources/**.json]
insert_final_newline = unset
